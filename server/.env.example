# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
# Ensure you append the database name /eventsphere before the query params:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/eventsphere?retryWrites=true&w=majority
# Redis Configuration (OPTIONAL for Phase 1 / Local Development)
# Leave commented out or unset if not running Redis. /health will display "not configured"
# REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=eventsphere_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
