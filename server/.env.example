# Server environment variables
# Copy this file to .env and set real values. NEVER commit the real .env file.

NODE_ENV=production
PORT=5000

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eventsphere?retryWrites=true&w=majority

# Redis connection URL (required)
REDIS_URL=redis://<username>:<password>@<host>:<port>

# JWT signing secret — use a long random string (required)
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRES_IN=7d

# QR ticket signing secret — use a different long random string (required)
QR_SECRET=<your-qr-secret>

# Comma-separated list of allowed frontend origins, no trailing slashes (required)
CORS_ORIGIN=https://your-vercel-app.vercel.app
