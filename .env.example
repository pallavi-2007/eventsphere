# ==========================================
# EventSphere Environment Configuration
# ==========================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/eventsphere?retryWrites=true&w=majority

# Redis Configuration (OPTIONAL)
# Leave unset or commented if not using Redis:
# REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=eventsphere_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CORS_ORIGIN=http://localhost:5173
